# Copy to .env.local for local dev. In production set these in Vercel → Settings → Environment Variables.

# Postgres (Neon). The Vercel ↔ Neon integration sets DATABASE_URL automatically.
DATABASE_URL=

# OANDA practice account (free) for live EUR/USD prices
OANDA_API_KEY=
OANDA_ACCOUNT_ID=
# OANDA_BASE_URL=https://api-fxpractice.oanda.com

# Anthropic API key for the bots
ANTHROPIC_API_KEY=
# Only if the key is not scoped to a workspace (API error asks for anthropic-workspace-id):
# ANTHROPIC_WORKSPACE_ID=
# LLM_MODEL=claude-haiku-5-5
# LLM_EFFORT=low
# LLM_MAX_TOKENS=2000
# LLM_INPUT_PRICE_PER_MTOK=0.1
# LLM_OUTPUT_PRICE_PER_MTOK=0.5

# Daily caps (UTC day). Bots pause once either is reached.
LLM_DAILY_BUDGET_USD=3
# LLM_MAX_CALLS_PER_DAY=2000

# Required: Vercel Cron sends "Authorization: Bearer $CRON_SECRET". Use a long random string.
CRON_SECRET=

# Optional: password-protect the dashboard (any username)
# DASHBOARD_PASSWORD=

# Optional
# SIM_SLIPPAGE_PIPS=0.1
# NEWS_FEED=on
# PRICE_SOURCE=mock   # local testing without OANDA
# LLM_PROVIDER=mock   # local testing without LLM spend
